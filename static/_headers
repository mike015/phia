# Cloudflare Pages headers (PROJECT-BRIEF §7/§8).
# Syntax: pad-patroon op eigen regel, gevolgd door "  Naam: waarde"-regels.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  # De Content-Security-Policy wordt door SvelteKit zelf gezet (hash-mode,
  # zie svelte.config.js) als <meta http-equiv> per pagina — zo krijgt de
  # inline hydration-script een geldige hash i.p.v. 'unsafe-inline'.
  # X-Frame-Options hierboven dekt frame-ancestors (die werkt niet via meta).
  # LATER: bij YouTube/Facebook-embeds frame-src/script-src uitbreiden in
  # svelte.config.js.

# Gehashte build-assets zijn immutable -> lang cachen
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Menu-PDF — kort cachen (owner vervangt deze via CMS)
/menu/*.pdf
  Cache-Control: public, max-age=3600

# Sveltia CMS (/admin) is een statische app (geen SvelteKit-route, dus geen meta-CSP).
# Eigen CSP: self-hosted bundle mag draaien en met GitHub praten voor de git-backend.
/admin/*
  X-Robots-Tag: noindex
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.githubusercontent.com https://avatars.githubusercontent.com; font-src 'self' data:; connect-src 'self' https://api.github.com https://github.com https://raw.githubusercontent.com; frame-src 'self' https://github.com; worker-src 'self' blob:
